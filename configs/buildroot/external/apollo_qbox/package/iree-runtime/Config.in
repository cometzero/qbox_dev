config BR2_PACKAGE_IREE_RUNTIME
	bool "IREE runtime tools"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_8 # C++17
	help
	  Build a minimal IREE runtime from the repo-local sources/iree
	  checkout and install iree-run-module into the target rootfs.

	  This package intentionally builds the runtime and local CPU HAL
	  only. The Apollo Hexagon registry/frontend remains a separate
	  repo-local guest tool staged with the QBox IREE smoke artifacts.

comment "iree-runtime needs a C++17 toolchain with thread support"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS || \
		!BR2_TOOLCHAIN_GCC_AT_LEAST_8
